# ==============================================================================
# CAFE LOVE BYTE — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your secret credentials.
# NEVER commit the real .env file with production secrets to version control.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# In production, use your MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cafe_love_byte?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/cafe_love_byte

# Security & Authentication Secrets
# Generate a strong 64-character secret for production (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Client Origin
CLIENT_URL=http://localhost:5173

# Default Administrative User Setup
ADMIN_NAME=Cafe Love Byte Administrator
ADMIN_EMAIL=admin@cafelovebyte.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Mailer / SMTP Service Credentials (Nodemailer)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
ADMIN_ALERT_EMAIL=manager@cafelovebyte.com
